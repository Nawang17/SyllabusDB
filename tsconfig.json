{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "allowJs": true, "checkJs": false, "noEmit": true,
    "skipLibCheck": true, "strictNullChecks": true,
    "baseUrl": ".", "paths": { "@/*": ["./src/*"] }, "types": ["vite/client", "node"]
  },
  "include": ["src", "vite.config.js"]
}
