# Firebase WEB configuration, intentionally public in the client bundle.
# Copy to .env.development.local or .env.production.local; never add Admin keys.
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_web_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id
# Always the production canonical origin, including preview builds.
VITE_SITE_ORIGIN=https://syllabusdb.com
# Set true for non-production builds (Netlify previews set it automatically).
VITE_NOINDEX=false
